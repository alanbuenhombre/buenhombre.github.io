{
  "name": "med-maquetador",
  "version": "0.2.1",
  "private": true,
  "description": "Maquetador local de catálogos MED: offline, sin IA, por reglas y plantillas.",
  "scripts": {
    "setup": "npm install && npx playwright install chromium",
    "start": "node src/server.js",
    "ficha": "node src/cli.js ficha",
    "exportar": "node src/cli.js exportar",
    "test": "node --test tests/*.test.js",
    "app": "electron app/main.js",
    "app:humo": "electron app/smoke.js",
    "dist:mac": "electron-builder --mac --arm64 --x64 --publish never"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "js-yaml": "4.1.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "3.11.174",
    "playwright": "1.56.1",
    "qrcode-generator": "1.4.4",
    "sharp": "0.33.5",
    "xlsx": "0.18.5"
  },
  "main": "app/main.js",
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "co.buenhombre.med.maquetador",
    "productName": "MED Maquetador",
    "copyright": "MED · uso interno",
    "directories": {
      "output": "dist"
    },
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "files": [
      "app/**",
      "src/**",
      "ui/**",
      "fonts/**",
      "ejemplos/**",
      "README.md",
      "!**/*.test.js",
      "!node_modules/playwright/**",
      "!node_modules/playwright-core/**",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**",
      "!node_modules/app-builder-*/**"
    ],
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.graphics-design",
      "icon": "app/icon.png",
      "identity": null,
      "minimumSystemVersion": "12.0"
    }
  }
}
